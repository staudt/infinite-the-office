      "recap": "Michael announces the Office Games to boost morale.",
      "beats": [
        {
          "type": "gather",
          "who": [
            "everyone"
          ],
          "to": "conference_room"
        },
        {
          "type": "say",
          "who": "michael",
          "text": "Today, we are having the Office Games. Events, medals, glory. Winner gets lunch with me. Loser also gets lunch with me.",
          "to": "all",
          "mood": "excited"
        },
        {
          "type": "say",
          "who": "toby",
          "text": "Technically, any prize requires an approved budget form.",
          "to": "michael",
          "mood": "neutral"
        },
        {
          "type": "say",
          "who": "michael",
          "text": "Toby, the only thing I need from you is to be gone.",
          "to": "toby",
          "mood": "annoyed"
        },
        {
          "type": "say",
          "who": "ryan",
          "text": "Do I have to compete? I feel like I'm more of an observer.",
          "to": "michael",
          "mood": "neutral"
        },
        {
          "type": "say",
          "who": "michael",
          "text": "Ryan, you will be head judge. Of everything. Judges are like kings, but with clipboards.",
          "to": "ryan",
          "mood": "happy"
        },
        {
          "type": "say",
          "who": "dwight",
          "text": "Question: does the winner become Assistant Regional Manager?",
          "to": "michael",
          "mood": "excited"
        },
        {
          "type": "say",
          "who": "michael",
          "text": "No. But there's a ribbon.",
          "to": "dwight",
          "mood": "neutral"
        },
        {
          "type": "say",
          "who": "dwight",
          "text": "I will take the ribbon and the principle.",
          "to": "michael",
          "mood": "deadpan"
        },
        {
          "type": "talking_head",
          "who": "michael",
          "lines": [
            "People say I do these things for attention. I do them for love. Which is attention, but warmer."
          ],
          "mood": "sad"
        }
      ]
    },
