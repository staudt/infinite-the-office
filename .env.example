# Claude API key used by the writer proxy (server/). Without it only stored episodes play.
ANTHROPIC_API_KEY=
# Model that writes each episode. Haiku is cheap enough to run forever; try claude-sonnet-5-5 for richer writing.
WRITER_MODEL=claude-haiku-5-5
# Model for the few long-term calls: season bibles and cast changes.
WRITER_PLAN_MODEL=claude-sonnet-5-5
PORT=8787
